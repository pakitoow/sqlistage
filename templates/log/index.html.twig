<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Upload Log File</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.css" />

    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --accent-color: #4cc9f0;
            --dark-color: #1a1a2e;
            --light-color: #f8f9fa;
            --success-color: #4caf50;
            --danger-color: #f44336;
            --warning-color: #ff9800;
            --info-color: #2196f3;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            min-height: 100vh;
            color: var(--dark-color);
        }

        .container {
            max-width: 1400px;
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: hidden;
            background: white;
            margin-bottom: 2rem;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border-bottom: none;
            padding: 1.25rem 1.5rem;
            border-radius: 12px 12px 0 0 !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 600;
        }

        h1 {
            color: var(--dark-color);
            position: relative;
            padding-bottom: 1rem;
            font-size: 2.5rem;
        }

        h1:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
            border-radius: 2px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: 0.5s;
        }

        .btn-primary:hover:before {
            left: 100%;
        }

        /* Log level colors */
        .log-INFO { background-color: rgba(23, 162, 184, 0.1); }
        .log-WARNING { background-color: rgba(255, 193, 7, 0.1); }
        .log-ERROR, .log-CRITICAL { background-color: rgba(220, 53, 69, 0.1); }
        .log-DEBUG { background-color: rgba(108, 117, 125, 0.1); }
        .log-NOTICE { background-color: rgba(111, 66, 193, 0.1); }
        .log-ALERT { background-color: rgba(253, 126, 20, 0.1); }
        .log-EMERGENCY { background-color: rgba(232, 62, 140, 0.1); }
        .log-UNKNOWN { background-color: rgba(173, 181, 189, 0.1); }

        .badge-INFO { background: linear-gradient(135deg, #17a2b8, #1fc8e3); }
        .badge-WARNING { background: linear-gradient(135deg, #ffc107, #ffab00); color: #212529; }
        .badge-ERROR { background: linear-gradient(135deg, #dc3545, #ff3d4a); }
        .badge-CRITICAL { background: linear-gradient(135deg, #dc3545, #c82333); }
        .badge-DEBUG { background: linear-gradient(135deg, #6c757d, #5a6268); }
        .badge-NOTICE { background: linear-gradient(135deg, #6f42c1, #5a32a3); }
        .badge-ALERT { background: linear-gradient(135deg, #fd7e14, #e66a0a); }
        .badge-EMERGENCY { background: linear-gradient(135deg, #e83e8c, #d62d7b); }
        .badge-UNKNOWN { background: linear-gradient(135deg, #adb5bd, #8f979f); }

        .log-message {
            word-break: break-word;
            max-width: 500px;
        }

        .log-datetime {
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            white-space: nowrap;
        }

        .stats-card {
            border-left: 4px solid var(--primary-color);
            background: white;
        }

        .filter-buttons .btn {
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 20px;
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        .filter-buttons .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .filter-buttons .btn.active {
            font-weight: 600;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        }

        .btn-outline-INFO {
            color: #17a2b8;
            border-color: #17a2b8;
        }

        .btn-outline-WARNING {
            color: #ffc107;
            border-color: #ffc107;
        }

        .btn-outline-ERROR, .btn-outline-CRITICAL {
            color: #dc3545;
            border-color: #dc3545;
        }

        .btn-outline-DEBUG {
            color: #6c757d;
            border-color: #6c757d;
        }

        .btn-outline-NOTICE {
            color: #6f42c1;
            border-color: #6f42c1;
        }

        .btn-outline-ALERT {
            color: #fd7e14;
            border-color: #fd7e14;
        }

        .btn-outline-EMERGENCY {
            color: #e83e8c;
            border-color: #e83e8c;
        }

        .btn-outline-UNKNOWN {
            color: #adb5bd;
            border-color: #adb5bd;
        }

        /* 3D Upload Card */
        .upload-card {
            position: relative;
            perspective: 1000px;
        }

        .upload-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }

        .upload-card:hover .upload-card-inner {
            transform: rotateY(10deg) rotateX(5deg);
        }

        /* Animated background for stats card */
        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(67, 97, 238, 0.03) 0%, rgba(76, 201, 240, 0.03) 100%);
            z-index: -1;
            border-radius: 12px;
        }

        /* Pulse animation for important elements */
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .pulse {
            animation: pulse 2s infinite;
        }

        /* Floating animation */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        .floating {
            animation: float 6s ease-in-out infinite;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(var(--primary-color), var(--secondary-color));
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--secondary-color);
        }

        /* Table styling */
        #logsTable {
            border-collapse: separate;
            border-spacing: 0;
        }

        #logsTable thead th {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border: none;
            padding: 1rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        #logsTable tbody tr {
            transition: all 0.2s ease;
        }

        #logsTable tbody tr:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        /* Custom file input */
        .custom-file-input {
            position: relative;
            overflow: hidden;
            display: inline-block;
            width: 100%;
        }

        .custom-file-input input[type="file"] {
            position: absolute;
            font-size: 100px;
            opacity: 0;
            right: 0;
            top: 0;
            cursor: pointer;
        }

        .custom-file-label {
            display: block;
            padding: 1rem;
            border: 2px dashed #ccc;
            border-radius: 8px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.7);
        }

        .custom-file-input:hover .custom-file-label {
            border-color: var(--primary-color);
            background: rgba(67, 97, 238, 0.05);
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            
            h1 {
                font-size: 2rem;
            }
            
            .card-body {
                padding: 1rem;
            }
        }

        /* Glow effect for important alerts */
        .alert-danger {
            box-shadow: 0 0 15px rgba(244, 67, 54, 0.3);
        }

        /* Tooltip styles */
        .tooltip-inner {
            background: var(--dark-color);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .bs-tooltip-auto[data-popper-placement^=top] .tooltip-arrow::before, 
        .bs-tooltip-top .tooltip-arrow::before {
            border-top-color: var(--dark-color);
        }

        /* Loading spinner */
        .spinner-border {
            width: 1.5rem;
            height: 1.5rem;
            border-width: 0.2em;
        }

        /* Date range picker custom styles */
        .daterangepicker {
            font-family: 'Poppins', sans-serif;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            border: none;
        }

        .daterangepicker td.active, 
        .daterangepicker td.active:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        }

        .daterangepicker .ranges li.active {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
        }

        .daterangepicker .drp-buttons .btn {
            border-radius: 8px;
            font-weight: 500;
            padding: 0.4rem 1rem;
        }

        .daterangepicker .drp-buttons .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
        }

        /* Send form styles */
 #sendFormContainer {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1050;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
        }

        #sendForm {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            position: relative;
            animation: animate__fadeInDown 0.3s;
            border: 1px solid rgba(0, 0, 0, 0.1);
        }

        #sendFormHeader {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }

        #sendFormTitle {
            margin: 0;
            font-size: 1.25rem;
            color: var(--primary-color);
        }

        #closeSendForm {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #6c757d;
            cursor: pointer;
            transition: all 0.2s;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        #closeSendForm:hover {
            color: #495057;
            background-color: #f8f9fa;
        }

        .form-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 1.5rem;
        }

        .btn-cancel {
            background-color: #f8f9fa;
            color: #6c757d;
        }

        .btn-cancel:hover {
            background-color: #e9ecef;
        }
    </style>
</head>
<body class="bg-light">
<div class="container mt-4 animate__animated animate__fadeIn">
    <div class="d-flex align-items-center mb-4">
        <div class="me-3">
            <i class="fas fa-file-alt fa-3x text-primary floating"></i>
        </div>
        <div>
            <h1 class="mb-0">Log File Analyzer</h1>
            <p class="text-muted mb-0">Upload and analyze your log files with powerful visualization</p>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                <i class="fas fa-{{ label == 'error' ? 'exclamation-triangle' : (label == 'success' ? 'check-circle' : 'info-circle') }} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card mb-4 upload-card">
        <div class="upload-card-inner">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-cloud-upload-alt me-2"></i>Upload Log File</h5>
            </div>
            <div class="card-body">
            {{ form_start(form, {
                 'attr': {'class': 'form-horizontal'},
                    'enctype': 'multipart/form-data'
                            }) }}

                    <div class="mb-3">
                        <div class="custom-file-input">
                            {{ form_widget(form.uploadFile, {'attr': {'class': 'form-control'}}) }}
                            <label for="{{ form.uploadFile.vars.id }}" class="custom-file-label">
                                <i class="fas fa-file-upload fa-2x mb-2 text-primary"></i>
                                <div class="fs-5">Choose a log file or drag it here</div>
                                <div class="text-muted">Supports .log, .txt files</div>
                            </label>
                        </div>
                        {{ form_errors(form.uploadFile) }}
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {% if logs is defined and logs|length > 0 %}
        {% set stats = {} %}
        {% set parsedCount = 0 %}
        {% for log in logs %}
            {% set level = log.level|default('UNKNOWN') %}
            {% set stats = stats|merge({(level): (stats[level] ?? 0) + 1}) %}
            {% if log.parsed %}
                {% set parsedCount = parsedCount + 1 %}
            {% endif %}
        {% endfor %}

        <div class="row mb-4 animate__animated animate__fadeInUp">
            <div class="col-md-8">
                <div class="card stats-card h-100">
                    <div class="card-body">
                        <h5 class="card-title d-flex align-items-center">
                            <i class="fas fa-chart-pie me-2 text-primary"></i>Log Statistics
                        </h5>
                        <div class="d-flex flex-wrap align-items-center mb-3">
                            <div class="me-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                                    <span class="fw-bold">Total:</span>
                                    <span class="ms-1">{{ logs|length }}</span>
                                </div>
                            </div>
                            <div class="me-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                                    <span class="fw-bold">Parsed:</span>
                                    <span class="ms-1">{{ parsedCount }}</span>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex align-items-center">
                                    <div class="bg-warning rounded-circle me-2" style="width: 12px; height: 12px;"></div>
                                    <span class="fw-bold">Not Parsed:</span>
                                    <span class="ms-1">{{ logs|length - parsedCount }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap">
                            {% for level, count in stats %}
                                <div class="me-3 mb-2">
                                    <span class="badge badge-{{ level }} rounded-pill p-2 d-flex align-items-center">
                                        <i class="fas fa-{{ level == 'ERROR' ? 'times-circle' : (level == 'WARNING' ? 'exclamation-triangle' : (level == 'INFO' ? 'info-circle' : 'question-circle')) }} me-1"></i>
                                        {{ level }}: {{ count }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title d-flex align-items-center">
                            <i class="fas fa-lightbulb me-2 text-warning"></i>Quick Actions
                        </h5>
                        <button class="btn btn-outline-primary btn-sm w-100 mb-2" id="exportAllBtn">
                            <i class="fas fa-file-export me-1"></i> Export All Logs
                        </button>
                        <button class="btn btn-outline-danger btn-sm w-100 mb-2" id="filterErrorsBtn">
                            <i class="fas fa-bug me-1"></i> Show Only Errors
                        </button>
                        <button class="btn btn-outline-success btn-sm w-100" id="expandAllBtn">
                            <i class="fas fa-expand me-1"></i> Expand All Messages
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# Filter buttons #}
        <div class="card mb-3 animate__animated animate__fadeInUp">
            <div class="card-body p-3">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="card-title mb-2 d-flex align-items-center">
                            <i class="fas fa-sliders-h me-2 text-primary"></i>Filter Logs
                        </h6>
                        <div class="filter-buttons mb-3">
                            <button class="btn btn-outline-secondary btn-sm active" data-level="all">
                                <i class="fas fa-layer-group me-1"></i> All Logs
                            </button>
                            {% for level in stats|keys %}
                                <button class="btn btn-outline-{{ level }} btn-sm" data-level="{{ level }}">
                                    <i class="fas fa-{{ level == 'ERROR' ? 'times-circle' : (level == 'WARNING' ? 'exclamation-triangle' : (level == 'INFO' ? 'info-circle' : 'question-circle')) }} me-1"></i>
                                    {{ level }} ({{ stats[level] }})
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="card-title mb-2 d-flex align-items-center">
                            <i class="far fa-calendar-alt me-2 text-primary"></i>Date Range
                        </h6>
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm" id="dateRangePicker" 
                                   placeholder="Select date range" autocomplete="off">
                            <button class="btn btn-outline-secondary btn-sm" type="button" id="clearDateRange">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# DataTable #}
        <div class="card animate__animated animate__fadeInUp">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list-ol me-2"></i>Parsed Logs
                    </h5>
                    <div class="text-muted small">
                        Showing <span id="filteredCount">{{ logs|length }}</span> of {{ logs|length }} records
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="logsTable" class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Timestamp</th>
                                <th>Level</th>
                                <th>Message</th>
                                <th class="pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr class="log-{{ log.level|default('UNKNOWN') }} position-relative">
                                    <td class="ps-4 fw-bold">{{ log.line_number }}</td>
                                    <td class="log-datetime">
                                        {% if log.datetime %}
                                            <span class="d-flex align-items-center">
                                                <i class="far fa-clock me-2 text-muted"></i>
                                                {{ log.datetime|date('Y-m-d H:i:s') }}
                                            </span>
                                        {% else %}
                                            <em class="text-muted">Unknown</em>
                                        {% endif %}
                                    </td>

                                    <td data-search="{{ log.level|default('UNKNOWN') }}">
                                        <span class="badge badge-{{ log.level|default('UNKNOWN') }} rounded-pill py-1 px-2">
                                            {{ log.level|default('UNKNOWN') }}
                                        </span>
                                    </td>

                                    <td class="log-message">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                {{ log.message }}
                                                {% if not log.parsed %}
                                                    <div class="mt-1">
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-exclamation-triangle me-1"></i> Not parsed
                                                        </span>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="pe-4">
                                        <button class="btn btn-sm btn-outline-primary send-log-btn" 
                                                data-line="{{ log.line_number }}"
                                                data-date="{% if log.datetime %}{{ log.datetime|date('Y-m-d H:i:s') }}{% endif %}"
                                                data-level="{{ log.level|default('UNKNOWN') }}"
                                                data-message="{{ log.message }}">
                                            <i class="fas fa-paper-plane"></i> Send
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    {% elseif logs is defined %}
        <div class="alert alert-info animate__animated animate__fadeIn">
            <i class="fas fa-info-circle me-2"></i> No log entries found or the file is empty.
        </div>
    {% endif %}
</div>

<!-- Send Form Container -->
<div id="sendFormContainer">
    <div id="sendForm">
        <div id="sendFormHeader">
            <h5 id="sendFormTitle"><i class="fas fa-paper-plane me-2"></i>Send Log Information</h5>
            <button id="closeSendForm" type="button" title="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <form id="sendLogForm" method="POST" action="/send-log">
            <input type="hidden" name="line" id="logLine">
            <input type="hidden" name="date" id="logDate">
            <input type="hidden" name="level" id="logLevel">
            <input type="hidden" name="message" id="logMessage">
            
            <div class="mb-3">
                <label for="recipient" class="form-label">Recipient (email or username)</label>
                <input type="text" class="form-control" name="recipient" id="recipient" required>
            </div>
            
            <div class="mb-3">
                <label for="additionalNotes" class="form-label">Additional Notes</label>
                <textarea class="form-control" name="additional_notes" id="additionalNotes" rows="3"></textarea>
            </div>
            
            <div class="form-footer">
                <button type="button" id="cancelSendForm" class="btn btn-cancel">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane me-1"></i> Send
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker@3.1.0/daterangepicker.min.js"></script>
<link href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.bootstrap5.min.css" rel="stylesheet">

<script>
    let dataTable;

    $(document).ready(function () {
        // Initialize tooltips
        $('[data-bs-toggle="tooltip"]').tooltip({
            trigger: 'hover'
        });

        // File input change handler
        $('input[type="file"]').change(function() {
            var fileName = $(this).val().split('\\').pop();
            if (fileName) {
                $(this).siblings('.custom-file-label').html(
                    '<i class="fas fa-file-alt me-2"></i>' + fileName
                );
            }
        });

        // Form submission loading indicator
        $('form').submit(function() {
            $(this).find('button[type="submit"]').prop('disabled', true);
            $(this).find('button[type="submit"]').html(
                '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...'
            );
        });

        // Initialize DataTable with enhanced features
        dataTable = $('#logsTable').DataTable({
            dom: '<"top"lfB>rt<"bottom"ip>',
            buttons: [
                {
                    extend: 'copy',
                    text: '<i class="fas fa-copy me-1"></i> Copy',
                    className: 'btn btn-sm btn-outline-secondary',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'csv',
                    text: '<i class="fas fa-file-csv me-1"></i> CSV',
                    className: 'btn btn-sm btn-outline-primary',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'excel',
                    text: '<i class="fas fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-sm btn-outline-success',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'print',
                    text: '<i class="fas fa-print me-1"></i> Print',
                    className: 'btn btn-sm btn-outline-dark',
                    exportOptions: {
                        columns: ':visible'
                    }
                }
            ],
            pageLength: 25,
            lengthMenu: [10, 25, 50, 100],
            order: [[0, 'asc']],
            language: {
                search: "<i class='fas fa-search me-2'></i> Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                paginate: {
                    first: "<i class='fas fa-angle-double-left'></i>",
                    last: "<i class='fas fa-angle-double-right'></i>",
                    next: "<i class='fas fa-angle-right'></i>",
                    previous: "<i class='fas fa-angle-left'></i>"
                },
                zeroRecords: "No matching records found"
            },
            responsive: true,
            initComplete: function() {
                $('.dt-buttons .btn').removeClass('btn-secondary');
            },
            drawCallback: function() {
                // Update filtered count
                $('#filteredCount').text(this.api().page.info().recordsDisplay);
                
                // Add animation to rows
                $('tbody tr').each(function(i) {
                    $(this).delay(i*50).css('display', 'table-row').animate({opacity: 1}, 100);
                });
            },
            columnDefs: [
                { targets: [2], searchable: true } // Make sure level column is searchable
            ]
        });

        // Fixed Filter buttons - now working correctly
        $('.filter-buttons button').on('click', function() {
            $('.filter-buttons button').removeClass('active');
            $(this).addClass('active');

            const level = $(this).data('level');
            if (level === 'all') {
                dataTable.search('').columns().search('').draw();
            } else {
                dataTable.columns(2).search('^' + level + '$', true, false).draw();
            }
        });

        // Initialize date range picker
        $('#dateRangePicker').daterangepicker({
            opens: 'left',
            autoUpdateInput: false,
            locale: {
                format: 'DD-MM-YYYY',
                cancelLabel: 'Clear',
                applyLabel: 'Apply',
                daysOfWeek: ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
                monthNames: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
                firstDay: 1
            },
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        });

        // Handle date range selection
        $('#dateRangePicker').on('apply.daterangepicker', function(ev, picker) {
            $(this).val(picker.startDate.format('DD-MM-YYYY') + ' to ' + picker.endDate.format('DD-MM-YYYY'));
            
            // Filter the table
            filterByDateRange(picker.startDate, picker.endDate);
        });

        // Clear date range
        $('#clearDateRange').click(function() {
            $('#dateRangePicker').val('');
            dataTable.columns(1).search('').draw();
            $('#filteredCount').text(dataTable.rows({ search: 'applied' }).count());
        });

        // Custom date range filtering function
        function filterByDateRange(startDate, endDate) {
            dataTable.column(1, {search: 'applied'}).nodes().each(function(node, index) {
                var dateText = $(node).text().trim();
                if (dateText === 'Unknown') {
                    $(node).parent().hide();
                    return;
                }
                
                try {
                    var rowDate = moment(dateText, 'YYYY-MM-DD HH:mm:ss');
                    if (rowDate.isBetween(startDate, endDate, null, '[]')) {
                        $(node).parent().show();
                    } else {
                        $(node).parent().hide();
                    }
                } catch (e) {
                    console.error('Error parsing date:', dateText, e);
                    $(node).parent().hide();
                }
            });
            
            // Update filtered count
            $('#filteredCount').text(dataTable.rows({ search: 'applied' }).count());
        }

        // Quick action buttons
        $('#exportAllBtn').click(function() {
            dataTable.button('.buttons-excel').trigger();
        });

        $('#filterErrorsBtn').click(function() {
            $('.filter-buttons button[data-level="all"]').click();
            dataTable.columns(2).search('ERROR|CRITICAL|EMERGENCY', true, false, true).draw();
            $('.filter-buttons button').removeClass('active');
            $('.filter-buttons button[data-level="ERROR"]').addClass('active');
        });

        $('#expandAllBtn').click(function() {
            const expandHandler = function() {
                $('.log-message').css('max-width', 'none');
                $(this).html('<i class="fas fa-compress me-1"></i> Collapse All Messages');
                $(this).off('click').click(function() {
                    $('.log-message').css('max-width', '500px');
                    $(this).html('<i class="fas fa-expand me-1"></i> Expand All Messages');
                    $('#expandAllBtn').click(expandHandler);
                });
            };
            expandHandler.call(this);
        });

        // Add hover effect to table rows
        $('#logsTable tbody').on('mouseenter', 'tr', function() {
            $(this).addClass('shadow-sm');
        }).on('mouseleave', 'tr', function() {
            $(this).removeClass('shadow-sm');
        });

        // Send log button functionality
        $(document).on('click', '.send-log-btn', function() {
            const line = $(this).data('line');
            const date = $(this).data('date');
            const level = $(this).data('level');
            const message = $(this).data('message');
            
            // Populate the form
            $('#logLine').val(line);
            $('#logDate').val(date || 'Unknown');
            $('#logLevel').val(level);
            $('#logMessage').val(message);
            
            // Show the form with animation
            $('#sendFormContainer').css('display', 'flex').hide().fadeIn(200);
        });

        // Close send form
            function closeSendForm() {
                $('#sendFormContainer').fadeOut(200);
            }

            $('#closeSendForm, #cancelSendForm').click(closeSendForm);

        // Close form on outside click
            $('#sendFormContainer').click(function(e) {
        if (e.target === this) {
            closeSendForm();
        }
    });

        // Handle form submission
        $('#sendLogForm').submit(function(e) {
            e.preventDefault();
            

         // Show loading state
        const submitBtn = $(this).find('button[type="submit"]');
        const originalText = submitBtn.html();
        submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Sending...');
            // In a real implementation, you would do something like:
            /*
            $.ajax({
                url: $(this).attr('action'),
                method: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    alert('Log information sent successfully!');
                    $('#sendFormContainer').fadeOut();
                },
                error: function(xhr) {
                    alert('Error sending log information: ' + xhr.responseText);
                }
            });
            */
        });
    });
</script>
</body>
</html>